rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isIndustry() { return signedIn() && role() == 'industry'; }

    // ---- User accounts ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && request.resource.data.role in ['student','academician','industry','institution'];
      allow update, delete: if isSelf(uid);
    }

    // ---- Role profiles (students readable for recruiting/analytics) ----
    match /students/{uid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(uid);
      // Industry may ONLY update denormalized analytics counters, nothing else:
      allow update: if isSelf(uid) ||
      (isIndustry() && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['applicationsCount','internshipCount','placementStatus','updatedAt']));
    }
    match /academicianProfiles/{uid} { allow read: if signedIn(); allow write: if isSelf(uid); }
    match /companies/{uid}          { allow read: if signedIn(); allow write: if isSelf(uid); }
    match /institutionProfiles/{uid}{ allow read: if signedIn(); allow write: if isSelf(uid); }

    // ---- Opportunities: public/signed-in read; only owner company may modify ----
    match /internships/{id} {
      allow read: if true;
      allow create: if isIndustry();
      allow update, delete: if signedIn() && resource.data.companyId == request.auth.uid;
    }
    match /jobs/{id} {
      allow read: if true;
      allow create: if isIndustry();
      allow update, delete: if signedIn() && resource.data.companyId == request.auth.uid;
    }
    match /learningPrograms/{id} {
      allow read: if signedIn();
      allow create: if isIndustry();
      allow update, delete: if signedIn() && resource.data.companyId == request.auth.uid;
    }
    match /academyOpportunities/{id} {
      allow read: if signedIn();
      allow create: if isIndustry();
      allow update, delete: if signedIn() && resource.data.companyId == request.auth.uid;
    }

    // ---- Applications: student owns own application; company manages status ----
    match /applications/{id} {
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || resource.data.companyId == request.auth.uid);
      allow update: if signedIn() && resource.data.companyId == request.auth.uid;
      allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }
    match /academyApplications/{id} {
      allow create: if signedIn() && request.resource.data.academicianId == request.auth.uid;
      allow read: if signedIn() && (resource.data.academicianId == request.auth.uid || resource.data.companyId == request.auth.uid);
      allow update: if signedIn() && resource.data.companyId == request.auth.uid;
      allow delete: if signedIn() && resource.data.academicianId == request.auth.uid;
    }

    // ---- Learning enrollments (student-owned) ----
    match /enrollments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    // ---- Skill assessments ----
    match /skillAssessments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.studentId == request.auth.uid;
    }

    // ---- Portfolios ----
    match /portfolios/{uid} { allow read: if signedIn(); allow write: if isSelf(uid); }

    // ---- Notifications: create by any signed-in user (system events), manage own ----
    match /notifications/{id} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- Institution ↔ industry partnership requests ----
    match /collaborationRequests/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow update: if signedIn() && resource.data.toUserId == request.auth.uid;
      allow delete: if signedIn() && resource.data.fromUserId == request.auth.uid;
    }

    // ---- Deny everything else ----
    match /{document=**} { allow read, write: if false; }
  }
}